# Build outputs
bin/
build/

# pivid-player CMake build trees, platform-named: build-arm (aarch64 cross,
# `make player`), build-macos (native, `make player-macos`), build-lat
# (LATPROBE measurement build), and any other build-<variant>. One CMakeLists
# drives all of them; the trees are throwaway.
apps/pivid-player/build-*/

# Object and module artefacts
*.o
*.ko
*.mod
*.mod.c
*.cmd
*.symvers
*.order
*.dtbo

# compiled host unit-test binaries (built in docker, not source).
# Tests live in per-subsystem subfolders (tests/common/, tests/tx/, ...), so
# match at any depth and re-include sources/scripts/headers.
tests/**/test_*
!tests/**/test_*.c
!tests/**/test_*.sh
!tests/**/test_*.h

# Bench-run output written by the A/B harnesses in scripts/ (raw counter dumps;
# the conclusions are distilled into docs/MEASUREMENTS.md).
bench-results/

# Large reference media used by the FEC/encoder sweeps (the 437-frame motion
# clip and any raw YUV). Provenance + sha256 are in docs/MEASUREMENTS.md;
# the canonical copy lives on the TX Pi at /root/pivid-assets/. Kept as a guard
# so a locally-fetched clip is never committed.
ref-assets/
*.yuv
*.ffv1.mkv

# Header-dependency files emitted by gcc -MMD
*.d

# git worktrees (isolated workspaces)
.worktrees/

# macOS
.DS_Store

# Editor / agent scratch state. .history/ is the VSCode Local History extension,
# which nests an entire second git repository -- keep it out repo-wide.
.claude/
.superpowers/
.history/

# generated embedded web asset (regenerated by the agent build)
apps/pivid-config-agent/src/webui.h
