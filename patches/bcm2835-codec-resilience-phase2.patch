+/* Phase-2: set a firmware MMAL param whose body is a single u32 (booleans too). */
+static int pivid_set_u32(struct bcm2835_codec_ctx *ctx, u32 mmal_id, u32 val)
+{
+	if (!ctx->component)
+		return 0;	/* applied again on the next set once streaming */
+	return vchiq_mmal_port_parameter_set(ctx->dev->instance,
+			&ctx->component->output[0], mmal_id, &val, sizeof(val));
+}
+
+/* Phase-2: (re)apply intra-refresh from cached mode/air/period. Called by the period,
+ * mode, and air setters, so userland set-order is irrelevant. */
+static int pivid_apply_intra_refresh(struct bcm2835_codec_ctx *ctx)
+{
+	struct bcm2835_codec_q_data *q = &ctx->q_data[V4L2_M2M_SRC];
+	u32 mbw = DIV_ROUND_UP(q->crop_width, 16);
+	u32 mbh = DIV_ROUND_UP(q->crop_height, 16);
+	struct mmal_parameter_video_intra_refresh ir;
+	u32 len = sizeof(ir), rows;
+
+	BUILD_BUG_ON(sizeof(ir) != 20);	/* 5 x u32; header added by mmal layer */
+	if (!ctx->component || !mbw || !mbh)
+		return 0;		/* geometry unset; re-applied on the next set */
+	memset(&ir, 0, sizeof(ir));
+	/* get-then-set: preserve firmware defaults for fields we don't drive. */
+	(void)vchiq_mmal_port_parameter_get(ctx->dev->instance,
+		&ctx->component->output[0],
+		MMAL_PARAMETER_VIDEO_INTRA_REFRESH, &ir, &len);
+	switch (ctx->refresh_mode) {	/* 0=CYCLIC 1=ADAPTIVE 2=BOTH 3=CYCLIC_MROWS */
+	case 1:  ir.refresh_mode = MMAL_VIDEO_INTRA_REFRESH_ADAPTIVE; break;
+	case 2:  ir.refresh_mode = MMAL_VIDEO_INTRA_REFRESH_BOTH; break;
+	case 3:  ir.refresh_mode = MMAL_VIDEO_INTRA_REFRESH_CYCLIC_MROWS; break;
+	default: ir.refresh_mode = MMAL_VIDEO_INTRA_REFRESH_CYCLIC; break;
+	}
+	/* MB-row-aligned cir_mbs, >= 2 rows so cir_mbs > mbw (firmware requirement). */
+	if (ctx->refresh_period) {
+		rows = DIV_ROUND_UP(mbh, ctx->refresh_period);
+		if (rows < 2)
+			rows = 2;
+		ir.cir_mbs = rows * mbw;
+	} else {
+		ir.cir_mbs = 0;
+	}
+	ir.air_mbs = ctx->refresh_air_mbs;	/* 0 unless ADAPTIVE/BOTH */
+	ir.air_ref = ctx->refresh_air_mbs ? 1 : 0;
+	ir.pir_mbs = 0;
+	return vchiq_mmal_port_parameter_set(ctx->dev->instance,
+		&ctx->component->output[0],
+		MMAL_PARAMETER_VIDEO_INTRA_REFRESH, &ir, sizeof(ir));
+}
