# embed_file(<in-path> <out-c-path> <symbol>) — generate a .c with:
#   const unsigned char <symbol>[] = {...}; const unsigned <symbol>_len = N;
# Portable (pure CMake file(READ HEX)); no xxd/objcopy needed.
# NOTE: embed_file() runs at configure time; editing a TTF requires re-running CMake.
function(embed_file IN OUT SYM)
  file(READ "${IN}" hex HEX)
  string(LENGTH "${hex}" n2)
  math(EXPR n "${n2} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
  file(WRITE "${OUT}"
    "/* generated by EmbedFile.cmake from ${IN} -- do not edit */\n"
    "const unsigned char ${SYM}[] = {${body}};\n"
    "const unsigned ${SYM}_len = ${n}u;\n")
endfunction()
